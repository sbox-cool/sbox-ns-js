{
  "name": "create-sbox-ns-backend",
  "version": "0.1.0",
  "description": "Scaffolds a runnable self-hosted sbox-ns backend: endpoints, collections, catalog modules, dev server, and tests.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "create-sbox-ns-backend": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
